# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=anthropic          # anthropic | ollama
EMBEDDING_PROVIDER=hash         # hash (offline fake) | minilm (needs requirements-ml.txt)
TOOL_TRANSPORT=mcp              # mcp (stdio MCP server) | local (in-process, used by tests)
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
